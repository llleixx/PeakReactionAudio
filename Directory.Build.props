<Project>
  <PropertyGroup>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <Deterministic>true</Deterministic>
    <Version>0.1.0</Version>
    <PeakGameDir Condition="'$(PeakGameDir)' == '' and '$(PEAK_GAME_DIR)' != ''">$(PEAK_GAME_DIR)</PeakGameDir>
    <PeakGameDir Condition="'$(PeakGameDir)' == ''">C:\Program Files (x86)\Steam\steamapps\common\PEAK</PeakGameDir>
  </PropertyGroup>
  <Import Project="PeakGameDir.props" Condition="Exists('PeakGameDir.props')" />
  <PropertyGroup>
    <ManagedDir>$(PeakGameDir)\PEAK_Data\Managed</ManagedDir>
    <BepInExCoreDir>$(PeakGameDir)\BepInEx\core</BepInExCoreDir>
  </PropertyGroup>
</Project>
